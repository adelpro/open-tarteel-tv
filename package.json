{
  "name": "open-tarteel-tv",
  "version": "2.0.0-athar",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "prebuild": "expo prebuild --clean",
    "android": "expo run:android -d",
    "ios": "expo run:ios",
    "run:tv:android": "cross-env EXPO_TV=1 expo run:android -d",
    "run:tv:ios": "cross-env EXPO_TV=1 expo run:ios",
    "prebuild:tv:android": "cross-env EXPO_TV=1 expo prebuild --clean --platform android",
    "prebuild:tv:ios": "cross-env EXPO_TV=1 expo prebuild --clean --platform ios",
    "build:tv:android:aab": "cross-env EXPO_TV=1 eas build -p android --profile production",
    "build:tv:android:local": "cross-env EXPO_TV=1 eas build -p android --profile production --local --output ./builds/production-build.aab",
    "build:tv:ios": "cross-env EXPO_TV=1 eas build -p ios --profile production",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commit": "git-cz"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.25",
    "@react-navigation/native-stack": "^7.8.6",
    "expo": "~54.0.29",
    "expo-audio": "~1.1.0",
    "expo-dev-client": "~6.0.20",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.10",
    "expo-splash-screen": "^31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "fast-text-encoding": "^1.0.6",
    "fuse.js": "^7.0.0",
    "gun": "^0.2020.1241",
    "i18next": "^25.7.3",
    "react": "19.1.0",
    "react-i18next": "^16.5.0",
    "react-native": "npm:react-native-tvos@0.81-stable",
    "react-native-get-random-values": "^2.0.0",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "^4.16.0",
    "react-tv-space-navigation": "^6.0.0-beta1"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.4.1",
    "@react-native-community/cli": "latest",
    "@react-native-tvos/config-tv": "^0.1.4",
    "@types/react": "~19.1.0",
    "commitlint": "^19.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.21.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.5",
    "lint-staged": "^16.2.7",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --cache",
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "private": true,
  "packageManager": "yarn@4.13.0+sha512.5c20ba010c99815433e5c8453112165e673f1c7948d8d2b267f4b5e52097538658388ebc9f9580656d9b75c5cc996f990f611f99304a2197d4c56d21eea370e7"
}
