# Open Tarteel TV provider configuration.
# All values are EXPO_PUBLIC_* and are bundled into the app binary at build
# time, so they can be extracted by anyone who installs the app. Never put real
# credentials in tracked files: keep them in .env.local (gitignored) or supply
# them as CI/build secrets under these exact names.

# Itqan
EXPO_PUBLIC_OTTV_ITQAN_BASE_URL=https://api.cms.itqan.dev
EXPO_PUBLIC_OTTV_ITQAN_API_KEY=your-itqan-api-key

# Qurani.ai
EXPO_PUBLIC_OTTV_QURANAI_BASE_URL=https://api.qurani.ai/gw/qh/v1

# Quran Foundation
EXPO_PUBLIC_OTTV_QF_CLIENT_ID=your-qf-client-id
EXPO_PUBLIC_OTTV_QF_CLIENT_SECRET=your-qf-client-secret
EXPO_PUBLIC_OTTV_QF_TOKEN_URL=https://oauth2.quran.foundation/oauth2/token
EXPO_PUBLIC_OTTV_QF_API_BASE=https://apis.quran.foundation
EXPO_PUBLIC_OTTV_QF_PUBLIC_API_BASE=https://api.quran.com/api/v4
EXPO_PUBLIC_OTTV_QF_RATE_LIMIT_MS=1100

# MP3Quran v4 (feature-flagged; disabled by default)
EXPO_PUBLIC_OTTV_ENABLE_MP3QURAN_V4=false
EXPO_PUBLIC_OTTV_MP3QURAN_V4_BASE_URL=https://api-staging.mp3quran.net/v4
