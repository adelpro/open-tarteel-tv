{
  "expo": {
    "name": "open-tarteel-tv",
    "slug": "open-tarteel-tv",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "scheme": "opentarteeltv",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },

      "predictiveBackGestureEnabled": false,
      "package": "com.opentarteel.tv",
      "intentFilters": [
        {
          "action": "MAIN",
          "category": ["LEANBACK_LAUNCHER"]
        },
        {
          "action": "VIEW",
          "category": ["DEFAULT", "BROWSABLE"],
          "data": {
            "scheme": "opentarteeltv"
          }
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-audio",
      [
        "@react-native-tvos/config-tv",
        {
          "isTV": true,
          "androidTVRequired": true,
          "androidTVIcon": "./assets/icon.png",
          "androidTVBanner": "./assets/tv-banner.png",
          "appleTVIdentifier": "com.opentarteel.tv",
          "appleTVImages": {
            "icon": "./assets/tv/icon-1280x768.png",
            "iconSmall": "./assets/tv/icon-400x240.png",
            "iconSmall2x": "./assets/tv/icon-800x480.png",
            "topShelf": "./assets/tv/topshelf-1920x720.png",
            "topShelf2x": "./assets/tv/topshelf-3840x1440.png",
            "topShelfWide": "./assets/tv/topshelf-2320x720.png",
            "topShelfWide2x": "./assets/tv/topshelf-4640x1440.png"
          }
        }
      ]
    ]
  }
}
